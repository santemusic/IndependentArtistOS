MCP_AUTH_TOKEN=replace-with-a-long-random-secret
MCP_PUBLIC_URL=https://your-mcp-host.example.com

# Notion public OAuth integration; authorize a separate workspace per artist
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=

# Governance defaults
MUSIC_OS_RUNTIME_MODE=SUPERVISED
MUSIC_OS_EXTERNAL_ACTIONS=APPROVAL_ONLY
