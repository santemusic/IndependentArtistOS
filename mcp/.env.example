MCP_AUTH_TOKEN=replace-with-a-long-random-secret
MCP_PUBLIC_URL=https://independent-artist-os-mcp.onrender.com

# Primary multi-tenant Artist OS backend.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=replace-with-publishable-anon-key
ARTIST_OS_APP_URL=https://your-artist-os.example.com

# Runtime governance.
MUSIC_OS_RUNTIME_MODE=SUPERVISED
MUSIC_OS_EXTERNAL_ACTIONS=APPROVAL_ONLY

# Legacy Notion adapter / OAuth bridge. Optional during migration.
NOTION_TOKEN=
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
MUSIC_OS_ARTIST_ID=default
MUSIC_OS_ARTIST_CONTEXT_PAGE_ID=
MUSIC_OS_PROJECTS_DATABASE_ID=
MUSIC_OS_TASKS_DATABASE_ID=
MUSIC_OS_AUTOMATION_RUNS_DATABASE_ID=
