{
  "$schema": "https://open-plugin-spec.org/schema/v1/plugin.json",
  "id": "music.sante.independent-artist-os",
  "name": "Independent Artist OS",
  "version": "1.0.0-rc.1",
  "description": "Production-hardened Wave-1 multi-agent operating company for independent artists, packaged for Buzz Persona Packs. Runtime production status remains gated by official Buzz validation and sandbox acceptance.",
  "author": "Independent Artist OS",
  "license": "MIT",
  "homepage": "https://github.com/santemusic/IndependentArtistOS",
  "keywords": [
    "music",
    "artist",
    "operations",
    "multi-agent",
    "buzz",
    "release",
    "content",
    "growth"
  ],
  "personas": [
    "agents/artist-ceo.persona.md",
    "agents/executive-chief-of-staff.persona.md",
    "agents/ops-ceo.persona.md",
    "agents/music-ceo.persona.md",
    "agents/release-ceo.persona.md",
    "agents/content-ceo.persona.md",
    "agents/growth-ceo.persona.md",
    "agents/data-ceo.persona.md",
    "agents/legal-ceo.persona.md",
    "agents/finance-ceo.persona.md",
    "agents/automation-ceo.persona.md",
    "agents/orchestrator.persona.md"
  ],
  "pack_instructions": "instructions.md",
  "defaults": {
    "temperature": 0.3,
    "triggers": {
      "mentions": true,
      "keywords": [],
      "all_messages": false
    },
    "thread_replies": true,
    "broadcast_replies": false
  }
}
